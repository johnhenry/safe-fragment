{
  "name": "@johnhenry/safe-fragment",
  "version": "0.0.0",
  "description": "Framework-agnostic Web Components for rendering HTML-like source into live DOM only after applying an explicit versioned security profile -- never innerHTML/insertAdjacentHTML on untrusted input.",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.0.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "tsup && node scripts/append-dts.mjs",
    "prepare": "node scripts/prepare.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fuzz": "node scripts/fuzz.mjs",
    "examples": "npm run build && vitest run --config vitest.examples.config.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:dist": "npm run build && vitest run --config vitest.dist.config.ts",
    "size": "node scripts/check-size.mjs"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "sanitizer",
    "sanitize-html",
    "xss",
    "security",
    "dompurify",
    "html-sanitizer",
    "innerHTML",
    "trusted-types"
  ],
  "author": "John Henry <john@iamjohnhenry.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/safe-fragment.git"
  },
  "homepage": "https://opensource.johnhenry.me/safe-fragment/",
  "bugs": {
    "url": "https://github.com/johnhenry/safe-fragment/issues"
  },
  "dependencies": {
    "dompurify": "3.4.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/browser": "^5.0.2",
    "@vitest/browser-playwright": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
